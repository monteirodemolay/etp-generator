rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regra existente: base principal do sistema (mantida por compatibilidade --
    // essas 4 pessoas continuam com acesso mesmo que o índice abaixo, por
    // algum motivo, não exista para elas).
    function naListaFixa() {
      return request.auth != null
        && request.auth.token.email in [
          'monteirodemolay@gmail.com',
          'laurides@rioverde.go.gov.br',
          'barbara.dias@rioverde.go.gov.br',
          'leonardomarconi@gmail.com'
        ];
    }

    // Qualquer pessoa com um cadastro ATIVO na coleção de usuários do
    // próprio sistema (Admin > Usuários) também é "da equipe" -- não só as
    // 4 pessoas da lista fixa acima. O índice "usrByEmail:{email}" é criado
    // e apagado automaticamente conforme o cadastro é salvo (ver
    // salvarUsuario em App.jsx): existe enquanto a pessoa está ativa, some
    // se ela for desativada ou excluída. Só a EXISTÊNCIA importa aqui --
    // não dá pra ler campos de dentro do documento numa regra de leitura,
    // então o próprio "existe ou não" já é o sinal de "pode ou não".
    function temCadastroAtivo() {
      return request.auth != null
        && exists(/databases/$(database)/documents/dados/$('usrByEmail:' + request.auth.token.email));
    }

    function daEquipe() {
      return naListaFixa() || temCadastroAtivo();
    }

    match /dados/{doc} {
      // Feriados ("feriado:...") e o conteúdo dos Termos de Uso e Privacidade
      // ("termos:...") são liberados para leitura pública, sem login — o
      // fornecedor precisa do calendário para o cálculo do prazo, e os
      // Termos precisam ser lidos por qualquer um, logado ou não. Nada
      // sensível (ETP, fornecedor, usuário) muda de regra: continua
      // exigindo login, como sempre.
      allow read: if daEquipe() || doc.matches('^feriado:.*') || doc.matches('^termos:.*');
      allow write: if daEquipe();
    }

    // Ordem de Fornecimento
    match /of_registros/{token} {
      allow list: if daEquipe();
      allow get: if true;
      allow create: if daEquipe();
      allow delete: if daEquipe();
      allow update: if daEquipe() || transicaoDoFornecedorEhValida() || disputaTransicaoDoFornecedorEhValida();

      function transicaoDoFornecedorEhValida() {
        let antes = resource.data;
        let depois = request.resource.data;
        let apenasEstesCamposMudaram = depois.diff(antes).affectedKeys().hasOnly([
          'status', 'dataAceite', 'prazoLimite', 'prazoLimiteISO',
          'reciboImutavel', 'motivoDivergencia', 'dataDivergencia', 'updatedAt'
        ]);
        // Primeira confirmação: de "Aguardando Aceite" para "Em Dia" ou "Divergência".
        let primeiraConfirmacao = antes.status == 'Aguardando Aceite'
          && (depois.status == 'Em Dia' || depois.status == 'Divergência');
        // Divergência relatada DEPOIS de já ter confirmado o recebimento -- só
        // pode ir pra frente (nunca desfazer a própria confirmação; isso
        // continua sendo só a equipe, ver desfazerConfirmacaoEntrega).
        let divergenciaAposConfirmar = antes.status == 'Em Dia' && depois.status == 'Divergência';
        return apenasEstesCamposMudaram && (primeiraConfirmacao || divergenciaAposConfirmar);
      }

      // Modo Disputa: o fornecedor pode escrever em "disputaAtual" (nunca em
      // "disputasEncerradas", que é só histórico gravado pela equipe) só
      // quando é genuinamente a vez dele -- adicionando EXATAMENTE uma
      // mensagem com autor "fornecedor", sem apagar nem alterar nenhuma
      // mensagem já existente.
      function disputaTransicaoDoFornecedorEhValida() {
        let antes = resource.data;
        let depois = request.resource.data;
        let apenasCamposDaDisputaMudaram = depois.diff(antes).affectedKeys().hasOnly([
          'disputaAtual', 'status', 'motivoDivergencia', 'dataDivergencia', 'updatedAt'
        ]);

        let antesD = antes.get('disputaAtual', null);
        let depoisD = depois.get('disputaAtual', null);

        // Abrindo a disputa pela primeira vez, junto com reportar uma
        // divergência -- a própria divergência já é a primeira mensagem.
        let abrindoComDivergencia = antesD == null && depoisD != null &&
          depoisD.resolucao == null &&
          depoisD.mensagens.size() == 1 &&
          depoisD.mensagens[0].autor == 'fornecedor';

        // Respondendo numa disputa já aberta (pela equipe, manualmente ou
        // por uma notificação de atraso), exatamente na vez do fornecedor.
        let respondendoNaVez = antesD != null && depoisD != null &&
          antesD.resolucao == null && depoisD.resolucao == null &&
          depoisD.mensagens.size() == antesD.mensagens.size() + 1 &&
          depoisD.mensagens[antesD.mensagens.size()].autor == 'fornecedor' &&
          (antesD.mensagens.size() == 0 || antesD.mensagens.size() == 2);

        return apenasCamposDaDisputaMudaram && (abrindoComDivergencia || respondendoNaVez);
      }
    }

    // Indice chave -> token, para conferencia publica
    match /of_indice_chave/{chave} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['token'])
        && get(/databases/$(database)/documents/of_registros/$(request.resource.data.token))
             .data.reciboImutavel.chave == chave;
      allow update, delete: if false;
    }

    // Indice CNPJ+email -> lista de tokens, para a central do fornecedor.
    // So a equipe (autenticada) escreve aqui -- e' mantido automaticamente
    // sempre que uma OF e salva, nunca pelo fornecedor. Publico so pode
    // "get" (ler um exatamente sabendo a chave), nunca "list" (listar
    // fornecedores), o que impede enumerar quem ja recebeu OF.
    match /of_fornecedor_indice/{chave} {
      allow get: if true;
      allow list: if false;
      allow create, update: if daEquipe();
      allow delete: if false;
    }

    // Indice loteId -> lista de tokens, para quando varias OFs da mesma
    // empresa sao disparadas juntas num unico e-mail. So a equipe cria
    // (no momento do disparo em lote); nunca e alterado depois -- criado
    // uma vez, publico so le pelo loteId exato (nunca lista todos os lotes).
    match /of_lote_indice/{loteId} {
      allow get: if true;
      allow list: if false;
      allow create: if daEquipe();
      allow update, delete: if false;
    }

    // Log de auditoria: so a equipe grava (autenticada), e so por "create".
    // Nenhum papel -- nem admin -- pode alterar ou apagar um evento ja
    // gravado. E' isso que da credibilidade ao log numa auditoria de verdade.
    match /log_auditoria/{eventoId} {
      allow read: if daEquipe();
      allow create: if daEquipe();
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
